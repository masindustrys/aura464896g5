{#
Enhanced Slider Component
A modern, animated slider with advanced features
#}

{% if component.slides and component.slides|length > 0 %}
<section class="enhanced-slider relative h-96 lg:h-[600px] overflow-hidden rounded-2xl bg-gray-900" data-animation="fade-in">
    <!-- Slides Container -->
    <div class="relative w-full h-full">
        {% for slide in component.slides %}
        <div class="slide absolute inset-0 transition-all duration-500 ease-in-out {{ loop.first ? 'active' : 'opacity-0' }}"
             data-slide="{{ loop.index0 }}">
            <!-- Background Image -->
            {% if slide.image %}
            <img src="{{ slide.image }}" 
                 alt="{{ slide.title|default('Slide ' ~ loop.index) }}"
                 class="slide-image absolute inset-0 w-full h-full object-{{ theme_settings.slider_background_size|default('cover') }}"
                 loading="{{ loop.first ? 'eager' : 'lazy' }}">
            {% endif %}
            
            <!-- Slide Content -->
            <div class="slide-content absolute inset-0 flex flex-col justify-center items-start p-8 lg:p-16 text-white">
                <!-- Background Overlay -->
                <div class="absolute inset-0 bg-gradient-to-r from-black/70 via-black/50 to-black/30"></div>
                
                <!-- Content Container -->
                <div class="relative z-10 max-w-2xl">
                    {% if slide.title %}
                    <h2 class="slide-title text-3xl lg:text-5xl font-bold mb-6 leading-tight">
                        {{ slide.title }}
                    </h2>
                    {% endif %}
                    
                    {% if slide.description %}
                    <p class="slide-description text-lg lg:text-xl mb-8 leading-relaxed text-white/90">
                        {{ slide.description }}
                    </p>
                    {% endif %}
                    
                    {% if slide.button_text and slide.button_url %}
                    <div class="slide-actions">
                        <a href="{{ slide.button_url }}" 
                           class="btn btn-primary btn-lg inline-flex items-center space-x-2 group">
                            <span>{{ slide.button_text }}</span>
                            <i class="sicon-arrow-{{ store.direction == 'rtl' ? 'left' : 'right' }} group-hover:translate-x-1 transition-transform"></i>
                        </a>
                    </div>
                    {% endif %}
                </div>
            </div>
        </div>
        {% endfor %}
    </div>
    
    <!-- Navigation Controls -->
    {% if component.slides|length > 1 %}
    <div class="slider-navigation">
        <!-- Previous Button -->
        <button class="slider-nav prev-btn absolute top-1/2 left-4 transform -translate-y-1/2 
                       w-12 h-12 bg-white/20 hover:bg-white/30 text-white rounded-full 
                       flex items-center justify-center transition-all duration-300 
                       hover:scale-110 backdrop-blur-sm"
                aria-label="{{ trans('common.previous') }}">
            <i class="sicon-arrow-{{ store.direction == 'rtl' ? 'right' : 'left' }} text-lg"></i>
        </button>
        
        <!-- Next Button -->
        <button class="slider-nav next-btn absolute top-1/2 right-4 transform -translate-y-1/2 
                       w-12 h-12 bg-white/20 hover:bg-white/30 text-white rounded-full 
                       flex items-center justify-center transition-all duration-300 
                       hover:scale-110 backdrop-blur-sm"
                aria-label="{{ trans('common.next') }}">
            <i class="sicon-arrow-{{ store.direction == 'rtl' ? 'left' : 'right' }} text-lg"></i>
        </button>
    </div>
    
    <!-- Dot Indicators -->
    <div class="slider-controls absolute bottom-6 left-1/2 transform -translate-x-1/2 flex space-x-3">
        {% for slide in component.slides %}
        <button class="indicator w-3 h-3 rounded-full bg-white/50 cursor-pointer transition-all duration-300 
                       hover:bg-white/80 {{ loop.first ? 'active bg-white scale-125' : '' }}"
                data-slide="{{ loop.index0 }}"
                aria-label="{{ trans('common.go_to_slide') }} {{ loop.index }}">
        </button>
        {% endfor %}
    </div>
    {% endif %}
    
    <!-- Progress Bar (Optional) -->
    {% if component.show_progress|default(false) %}
    <div class="absolute bottom-0 left-0 w-full h-1 bg-white/20">
        <div class="progress-bar h-full bg-white transition-all duration-5000 ease-linear w-0"></div>
    </div>
    {% endif %}
</section>

<!-- Schema Markup for SEO -->
<script type="application/ld+json">
{
    "@context": "https://schema.org",
    "@type": "ImageGallery",
    "name": "{{ store.name }} Featured Gallery",
    "description": "Featured products and promotions",
    "image": [
        {% for slide in component.slides %}
        "{{ slide.image }}"{% if not loop.last %},{% endif %}
        {% endfor %}
    ]
}
</script>
{% endif %}