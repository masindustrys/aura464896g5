{% extends 'layouts/master.twig' %}

{% block title %}{{ store.name }} - {{ trans('common.home') }}{% endblock %}

{% block body_class %}home-page aura-theme-home{% endblock %}

{% block content %}

{# Enhanced Hero Slider Component #}
{% if page.components['enhanced-slider'] %}
    {% include 'components/home/enhanced-slider.twig' with {component: page.components['enhanced-slider']} %}
{% endif %}

{# Main Links Component #}
{% if page.components['main-links'] %}
    {% include 'components/home/main-links.twig' with {component: page.components['main-links']} %}
{% endif %}

{# Featured Products with Modern Layout #}
{% if store.featured_products %}
<section class="featured-products py-16" data-animation="slide-up">
    <div class="container mx-auto px-4">
        <div class="text-center mb-12">
            <h2 class="text-3xl lg:text-4xl font-bold text-secondary-900 mb-4">
                {{ trans('home.featured_products') }}
            </h2>
            <p class="text-lg text-secondary-600 max-w-2xl mx-auto">
                {{ trans('home.discover_products') }}
            </p>
        </div>
        
        <div class="products-grid grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6" data-animation="stagger">
            {% for product in store.featured_products|slice(0, 8) %}
                {% include 'components/product/product-card.twig' with {product: product} %}
            {% endfor %}
        </div>
        
        <div class="text-center mt-12">
            <a href="{{ store.url('products.index') }}" 
               class="btn btn-outline inline-flex items-center space-x-2 group">
                <span>{{ trans('home.view_all_products') }}</span>
                <i class="sicon-arrow-{{ store.direction == 'rtl' ? 'left' : 'right' }} group-hover:translate-x-1 transition-transform"></i>
            </a>
        </div>
    </div>
</section>
{% endif %}

{# Enhanced Square Banners Component #}
{% if page.components['enhanced-square-banners'] %}
    {% include 'components/home/enhanced-square-banners.twig' with {component: page.components['enhanced-square-banners']} %}
{% endif %}

{# Best Sellers Slider #}
{% if store.best_selling_products %}
<section class="best-sellers py-16 bg-secondary-50" data-animation="slide-up">
    <div class="container mx-auto px-4">
        <div class="flex items-center justify-between mb-8">
            <div>
                <h2 class="text-3xl lg:text-4xl font-bold text-secondary-900 mb-2">
                    {{ trans('home.best_sellers') }}
                </h2>
                <p class="text-lg text-secondary-600">
                    {{ trans('home.popular_products')|default('Our most popular products') }}
                </p>
            </div>
            <div class="hidden lg:flex space-x-2">
                <button class="bestsellers-prev w-10 h-10 bg-white border border-secondary-200 
                               hover:bg-primary-600 hover:border-primary-600 hover:text-white 
                               text-secondary-600 rounded-full flex items-center justify-center 
                               transition-all duration-200 disabled:opacity-50"
                        aria-label="{{ trans('common.previous') }}">
                    <i class="sicon-arrow-{{ store.direction == 'rtl' ? 'right' : 'left' }}"></i>
                </button>
                <button class="bestsellers-next w-10 h-10 bg-white border border-secondary-200 
                               hover:bg-primary-600 hover:border-primary-600 hover:text-white 
                               text-secondary-600 rounded-full flex items-center justify-center 
                               transition-all duration-200 disabled:opacity-50"
                        aria-label="{{ trans('common.next') }}">
                    <i class="sicon-arrow-{{ store.direction == 'rtl' ? 'left' : 'right' }}"></i>
                </button>
            </div>
        </div>
        
        <div class="products-slider overflow-hidden">
            <div class="slider-track flex transition-transform duration-500 ease-out">
                {% for product in store.best_selling_products %}
                <div class="product-slide flex-none w-full sm:w-1/2 lg:w-1/4 px-3">
                    {% include 'components/product/product-card.twig' with {product: product} %}
                </div>
                {% endfor %}
            </div>
        </div>
    </div>
</section>
{% endif %}

{# Store Features Section #}
<section class="store-features py-16" data-animation="slide-up">
    <div class="container mx-auto px-4">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
            <div class="feature-item text-center group">
                <div class="w-16 h-16 mx-auto mb-4 bg-primary-100 text-primary-600 rounded-full 
                            flex items-center justify-center group-hover:bg-primary-600 group-hover:text-white 
                            transition-all duration-300">
                    <i class="sicon-truck text-2xl"></i>
                </div>
                <h3 class="font-semibold text-secondary-900 mb-2">{{ trans('features.free_shipping') }}</h3>
                <p class="text-sm text-secondary-600">{{ trans('features.free_shipping_desc') }}</p>
            </div>
            
            <div class="feature-item text-center group">
                <div class="w-16 h-16 mx-auto mb-4 bg-primary-100 text-primary-600 rounded-full 
                            flex items-center justify-center group-hover:bg-primary-600 group-hover:text-white 
                            transition-all duration-300">
                    <i class="sicon-refresh text-2xl"></i>
                </div>
                <h3 class="font-semibold text-secondary-900 mb-2">{{ trans('features.money_back_guarantee') }}</h3>
                <p class="text-sm text-secondary-600">{{ trans('features.money_back_desc') }}</p>
            </div>
            
            <div class="feature-item text-center group">
                <div class="w-16 h-16 mx-auto mb-4 bg-primary-100 text-primary-600 rounded-full 
                            flex items-center justify-center group-hover:bg-primary-600 group-hover:text-white 
                            transition-all duration-300">
                    <i class="sicon-headset text-2xl"></i>
                </div>
                <h3 class="font-semibold text-secondary-900 mb-2">{{ trans('features.24_7_support') }}</h3>
                <p class="text-sm text-secondary-600">{{ trans('features.support_desc') }}</p>
            </div>
            
            <div class="feature-item text-center group">
                <div class="w-16 h-16 mx-auto mb-4 bg-primary-100 text-primary-600 rounded-full 
                            flex items-center justify-center group-hover:bg-primary-600 group-hover:text-white 
                            transition-all duration-300">
                    <i class="sicon-shield-check text-2xl"></i>
                </div>
                <h3 class="font-semibold text-secondary-900 mb-2">{{ trans('features.secure_payment') }}</h3>
                <p class="text-sm text-secondary-600">{{ trans('features.secure_payment_desc') }}</p>
            </div>
        </div>
    </div>
</section>

{# Brands Component #}
{% if page.components['brands'] %}
    {% include 'components/home/brands.twig' with {component: page.components['brands']} %}
{% endif %}

{# Custom Testimonials Component #}
{% if page.components['custom-testimonials'] %}
    {% include 'components/home/custom-testimonials.twig' with {component: page.components['custom-testimonials']} %}
{% endif %}

{# Special Offers Banner #}
{% if store.special_offers %}
<section class="special-offers py-16 bg-gradient-to-r from-primary-600 to-accent-500" data-animation="slide-up">
    <div class="container mx-auto px-4">
        <div class="text-center text-white">
            <h2 class="text-3xl lg:text-4xl font-bold mb-4">
                {{ trans('home.special_offers') }}
            </h2>
            <p class="text-xl mb-8 opacity-90">
                {{ trans('home.limited_time_offers')|default('Limited time offers - Don\'t miss out!') }}
            </p>
            
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                {% for offer in store.special_offers|slice(0, 3) %}
                <div class="offer-card bg-white/10 backdrop-blur-sm rounded-xl p-6 text-center 
                            hover:bg-white/20 transition-all duration-300 group">
                    {% if offer.image %}
                    <img src="{{ offer.image }}" 
                         alt="{{ offer.title }}"
                         class="w-20 h-20 mx-auto mb-4 rounded-full object-cover">
                    {% endif %}
                    <h3 class="text-xl font-bold mb-2">{{ offer.title }}</h3>
                    <p class="mb-4 opacity-90">{{ offer.description }}</p>
                    {% if offer.discount %}
                    <div class="text-2xl font-bold mb-4">{{ offer.discount }}% OFF</div>
                    {% endif %}
                    <a href="{{ offer.url }}" 
                       class="btn bg-white text-primary-600 hover:bg-secondary-100 inline-flex items-center space-x-2 group">
                        <span>{{ trans('common.shop_now') }}</span>
                        <i class="sicon-arrow-{{ store.direction == 'rtl' ? 'left' : 'right' }} group-hover:translate-x-1 transition-transform"></i>
                    </a>
                </div>
                {% endfor %}
            </div>
        </div>
    </div>
</section>
{% endif %}

{# Newsletter Section #}
<section class="newsletter-section py-16 bg-secondary-900 text-white" data-animation="slide-up">
    <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto text-center">
            <h2 class="text-3xl lg:text-4xl font-bold mb-4">
                {{ trans('home.stay_updated') }}
            </h2>
            <p class="text-xl mb-8 opacity-90">
                {{ trans('home.subscribe_discount') }}
            </p>
            
            <form class="newsletter-form max-w-md mx-auto" action="{{ store.url('newsletter.subscribe') }}" method="post">
                <div class="flex flex-col sm:flex-row gap-4">
                    <input type="email" 
                           name="email" 
                           placeholder="{{ trans('newsletter.enter_email') }}" 
                           required
                           class="flex-1 px-4 py-3 rounded-lg border border-secondary-700 bg-secondary-800 
                                  text-white placeholder-secondary-400 focus:outline-none focus:ring-2 
                                  focus:ring-primary-500 focus:border-transparent">
                    <button type="submit" 
                            class="btn bg-primary-600 hover:bg-primary-700 text-white px-8 py-3 rounded-lg 
                                   font-medium transition-all duration-200 hover:scale-105">
                        {{ trans('newsletter.subscribe') }}
                    </button>
                </div>
                <p class="text-sm mt-4 opacity-75">
                    {{ trans('newsletter.privacy_notice')|default('We respect your privacy. Unsubscribe at any time.') }}
                </p>
            </form>
        </div>
    </div>
</section>

{% endblock %}

{% block scripts %}
<script>
document.addEventListener('DOMContentLoaded', function() {
    // Initialize Aura Theme if available
    if (window.AuraTheme && window.AuraTheme.initProductSliders) {
        window.AuraTheme.initProductSliders();
    }
    
    // Newsletter form submission
    const newsletterForm = document.querySelector('.newsletter-form');
    if (newsletterForm) {
        newsletterForm.addEventListener('submit', function(e) {
            e.preventDefault();
            
            const formData = new FormData(this);
            const email = formData.get('email');
            
            if (email) {
                // Show success message
                if (window.AuraTheme && window.AuraTheme.showNotification) {
                    window.AuraTheme.showNotification('{{ trans('newsletter.subscribed') }}', 'success');
                } else {
                    alert('{{ trans('newsletter.subscribed') }}');
                }
                
                // Reset form
                this.reset();
            }
        });
    }
});
</script>
{% endblock %}