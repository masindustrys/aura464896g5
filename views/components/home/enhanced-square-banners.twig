{#
Enhanced Square Banners Component
Modern square image banners with overlay content
#}

{% if component.banners and component.banners|length > 0 %}
<section class="enhanced-square-banners py-16" data-animation="slide-up">
    <div class="container mx-auto px-4">
        <!-- Section Header -->
        {% if component.title %}
        <div class="text-center mb-12">
            <h2 class="text-3xl lg:text-4xl font-bold text-secondary-900 mb-4">
                {{ component.title }}
            </h2>
            {% if component.description %}
            <p class="text-lg text-secondary-600 max-w-2xl mx-auto">
                {{ component.description }}
            </p>
            {% endif %}
        </div>
        {% endif %}
        
        <!-- Banners Grid -->
        <div class="square-banners grid grid-cols-1 md:grid-cols-2 lg:grid-cols-{{ component.banners|length > 3 ? '3' : component.banners|length }} gap-6" 
             data-animation="stagger">
            {% for banner in component.banners %}
            <div class="banner-item relative group overflow-hidden rounded-xl cursor-pointer"
                 style="aspect-ratio: 1;">
                
                <!-- Banner Link -->
                {% if banner.url %}
                <a href="{{ banner.url }}" class="absolute inset-0 z-10" aria-label="{{ banner.title|default('Banner ' ~ loop.index) }}"></a>
                {% endif %}
                
                <!-- Banner Image -->
                {% if banner.image %}
                <img src="{{ banner.image }}" 
                     alt="{{ banner.title|default('Banner ' ~ loop.index) }}"
                     class="banner-image absolute inset-0 w-full h-full object-{{ theme_settings.squar_photo_bg_image_size|default('cover') }} 
                            transition-transform duration-500 group-hover:scale-110"
                     loading="lazy">
                {% else %}
                <!-- Placeholder Background -->
                <div class="absolute inset-0 bg-gradient-to-br from-primary-400 to-primary-600"></div>
                {% endif %}
                
                <!-- Overlay -->
                <div class="banner-overlay absolute inset-0 bg-gradient-to-t from-black/80 via-black/40 to-transparent 
                            opacity-80 group-hover:opacity-90 transition-opacity duration-300"></div>
                
                <!-- Content -->
                {% if banner.title or banner.description %}
                <div class="banner-content absolute bottom-0 left-0 right-0 p-6 text-white transform 
                            translate-y-2 group-hover:translate-y-0 transition-transform duration-300">
                    {% if banner.title %}
                    <h3 class="banner-title text-xl font-bold mb-2 leading-tight">
                        {{ banner.title }}
                    </h3>
                    {% endif %}
                    
                    {% if banner.description %}
                    <p class="banner-description text-sm opacity-90 line-clamp-2">
                        {{ banner.description }}
                    </p>
                    {% endif %}
                    
                    <!-- CTA Button (Optional) -->
                    {% if banner.button_text %}
                    <div class="mt-4 opacity-0 group-hover:opacity-100 transition-opacity duration-300 delay-100">
                        <span class="inline-flex items-center text-sm font-medium text-white 
                                     hover:text-primary-300 transition-colors">
                            {{ banner.button_text }}
                            <i class="sicon-arrow-{{ store.direction == 'rtl' ? 'left' : 'right' }} ml-2"></i>
                        </span>
                    </div>
                    {% endif %}
                </div>
                {% endif %}
                
                <!-- Hover Effect Indicator -->
                <div class="absolute top-4 right-4 w-8 h-8 bg-white/20 rounded-full flex items-center 
                            justify-center opacity-0 group-hover:opacity-100 transition-all duration-300 
                            transform scale-75 group-hover:scale-100 backdrop-blur-sm">
                    <i class="sicon-arrow-{{ store.direction == 'rtl' ? 'left' : 'right' }} text-white text-sm"></i>
                </div>
                
                <!-- Badge (Optional) -->
                {% if banner.badge %}
                <div class="absolute top-4 left-4 px-3 py-1 bg-accent-500 text-white text-xs font-medium 
                            rounded-full transform -rotate-3 group-hover:rotate-0 transition-transform duration-300">
                    {{ banner.badge }}
                </div>
                {% endif %}
            </div>
            {% endfor %}
        </div>
        
        <!-- View All Button (Optional) -->
        {% if component.view_all_url %}
        <div class="text-center mt-12">
            <a href="{{ component.view_all_url }}" 
               class="btn btn-outline inline-flex items-center space-x-2 group">
                <span>{{ trans('common.view_all') }}</span>
                <i class="sicon-arrow-{{ store.direction == 'rtl' ? 'left' : 'right' }} group-hover:translate-x-1 transition-transform"></i>
            </a>
        </div>
        {% endif %}
    </div>
</section>

<!-- Schema Markup for SEO -->
<script type="application/ld+json">
{
    "@context": "https://schema.org",
    "@type": "ItemList",
    "name": "Featured Categories",
    "description": "Featured product categories and promotions",
    "numberOfItems": {{ component.banners|length }},
    "itemListElement": [
        {% for banner in component.banners %}
        {
            "@type": "ListItem",
            "position": {{ loop.index }},
            "item": {
                "@type": "Thing",
                "name": "{{ banner.title|default('Banner ' ~ loop.index) }}",
                "description": "{{ banner.description|default(banner.title) }}",
                "image": "{{ banner.image }}",
                "url": "{{ banner.url|default(store.url) }}"
            }
        }{% if not loop.last %},{% endif %}
        {% endfor %}
    ]
}
</script>
{% endif %}