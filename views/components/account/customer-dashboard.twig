{#
  Advanced Customer Account Dashboard
  Modern account management with analytics and personalization
#}

<div class="account-dashboard bg-white rounded-xl border border-secondary-200 overflow-hidden"
     data-component="account-dashboard">
     
    <!-- Dashboard Header -->
    <div class="dashboard-header p-6 bg-gradient-to-r from-primary-50 to-secondary-50 border-b border-secondary-200">
        <div class="flex items-center justify-between">
            <div class="flex items-center space-x-4">
                <!-- User Avatar -->
                <div class="user-avatar relative">
                    {% if user.avatar %}
                    <img src="{{ user.avatar }}" 
                         alt="{{ user.name }}"
                         class="w-16 h-16 rounded-full object-cover border-4 border-white shadow-md">
                    {% else %}
                    <div class="w-16 h-16 bg-primary-600 rounded-full flex items-center justify-center border-4 border-white shadow-md">
                        <span class="text-white text-xl font-bold">
                            {{ user.first_name|slice(0, 1)|upper }}{{ user.last_name|slice(0, 1)|upper }}
                        </span>
                    </div>
                    {% endif %}
                    
                    <!-- Status Indicator -->
                    <div class="absolute bottom-0 right-0 w-5 h-5 bg-green-500 border-2 border-white rounded-full"></div>
                </div>
                
                <!-- User Info -->
                <div>
                    <h2 class="text-2xl font-bold text-secondary-900">
                        {{ 'Welcome back, %s!'|t|format(user.first_name|default(user.name)) }}
                    </h2>
                    <p class="text-sm text-secondary-600">
                        {{ 'Member since %s'|t|format(user.created_at|date('M Y')) }} • 
                        {{ user.loyalty_tier ? 'Loyalty Tier: ' ~ user.loyalty_tier : 'New Customer' }}
                    </p>
                </div>
            </div>
            
            <!-- Quick Actions -->
            <div class="quick-actions flex items-center space-x-3">
                <button class="btn btn-outline btn-sm flex items-center space-x-2"
                        data-edit-profile>
                    <i class="sicon-edit"></i>
                    <span>{{ 'Edit Profile'|t }}</span>
                </button>
                
                <div class="notifications-dropdown relative">
                    <button class="notification-toggle w-10 h-10 bg-white border border-secondary-200 rounded-full flex items-center justify-center text-secondary-600 hover:text-primary-600 transition-colors relative"
                            data-notifications-toggle>
                        <i class="sicon-bell"></i>
                        {% if user.unread_notifications_count > 0 %}
                        <span class="absolute -top-1 -right-1 w-5 h-5 bg-red-500 text-white text-xs rounded-full flex items-center justify-center">
                            {{ user.unread_notifications_count }}
                        </span>
                        {% endif %}
                    </button>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Dashboard Stats -->
    <div class="dashboard-stats p-6 border-b border-secondary-200">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
            
            <!-- Total Orders -->
            <div class="stat-card bg-blue-50 border border-blue-200 rounded-xl p-4">
                <div class="flex items-center space-x-3">
                    <div class="w-12 h-12 bg-blue-100 rounded-full flex items-center justify-center">
                        <i class="sicon-shopping-bag text-blue-600 text-xl"></i>
                    </div>
                    <div>
                        <div class="text-2xl font-bold text-blue-900">{{ user.orders_count|default(0) }}</div>
                        <div class="text-sm text-blue-600">{{ 'Total Orders'|t }}</div>
                    </div>
                </div>
                <div class="mt-3 text-xs text-blue-600">
                    {% if user.last_order_date %}
                    {{ 'Last order: %s'|t|format(user.last_order_date|time_ago) }}
                    {% else %}
                    {{ 'No orders yet'|t }}
                    {% endif %}
                </div>
            </div>
            
            <!-- Total Spent -->
            <div class="stat-card bg-green-50 border border-green-200 rounded-xl p-4">
                <div class="flex items-center space-x-3">
                    <div class="w-12 h-12 bg-green-100 rounded-full flex items-center justify-center">
                        <i class="sicon-dollar-sign text-green-600 text-xl"></i>
                    </div>
                    <div>
                        <div class="text-2xl font-bold text-green-900">{{ user.total_spent|default(0)|money }}</div>
                        <div class="text-sm text-green-600">{{ 'Total Spent'|t }}</div>
                    </div>
                </div>
                <div class="mt-3 text-xs text-green-600">
                    {{ 'Average order: %s'|t|format(user.average_order_value|default(0)|money) }}
                </div>
            </div>
            
            <!-- Loyalty Points -->
            <div class="stat-card bg-purple-50 border border-purple-200 rounded-xl p-4">
                <div class="flex items-center space-x-3">
                    <div class="w-12 h-12 bg-purple-100 rounded-full flex items-center justify-center">
                        <i class="sicon-star text-purple-600 text-xl"></i>
                    </div>
                    <div>
                        <div class="text-2xl font-bold text-purple-900">{{ user.loyalty_points|default(0) }}</div>
                        <div class="text-sm text-purple-600">{{ 'Loyalty Points'|t }}</div>
                    </div>
                </div>
                <div class="mt-3 text-xs text-purple-600">
                    {{ 'Worth %s in rewards'|t|format((user.loyalty_points / 100)|money) }}
                </div>
            </div>
            
            <!-- Wishlist Items -->
            <div class="stat-card bg-pink-50 border border-pink-200 rounded-xl p-4">
                <div class="flex items-center space-x-3">
                    <div class="w-12 h-12 bg-pink-100 rounded-full flex items-center justify-center">
                        <i class="sicon-heart text-pink-600 text-xl"></i>
                    </div>
                    <div>
                        <div class="text-2xl font-bold text-pink-900">{{ user.wishlist_count|default(0) }}</div>
                        <div class="text-sm text-pink-600">{{ 'Wishlist Items'|t }}</div>
                    </div>
                </div>
                <div class="mt-3 text-xs text-pink-600">
                    {% if user.wishlist_on_sale_count > 0 %}
                    {{ '%d items on sale'|t|format(user.wishlist_on_sale_count) }}
                    {% else %}
                    {{ 'No items on sale'|t }}
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
    
    <!-- Dashboard Content -->
    <div class="dashboard-content grid grid-cols-1 lg:grid-cols-3 gap-6 p-6">
        
        <!-- Main Content -->
        <div class="main-content lg:col-span-2 space-y-6">
            
            <!-- Recent Orders -->
            <div class="recent-orders bg-white border border-secondary-200 rounded-xl overflow-hidden">
                <div class="section-header flex items-center justify-between p-4 border-b border-secondary-200">
                    <h3 class="text-lg font-semibold text-secondary-900">{{ 'Recent Orders'|t }}</h3>
                    <a href="{{ store.url('customer.orders') }}" 
                       class="text-primary-600 hover:text-primary-700 text-sm font-medium">
                        {{ 'View all'|t }}
                    </a>
                </div>
                
                {% if user.recent_orders|length > 0 %}
                <div class="orders-list">
                    {% for order in user.recent_orders|slice(0, 3) %}
                    <div class="order-item p-4 border-b border-secondary-200 last:border-b-0 hover:bg-secondary-50 transition-colors">
                        <div class="flex items-center justify-between">
                            <div class="flex items-center space-x-4">
                                <!-- Order Status Icon -->
                                <div class="order-status">
                                    {% if order.status == 'delivered' %}
                                    <div class="w-10 h-10 bg-green-100 rounded-full flex items-center justify-center">
                                        <i class="sicon-check text-green-600"></i>
                                    </div>
                                    {% elseif order.status == 'shipped' %}
                                    <div class="w-10 h-10 bg-blue-100 rounded-full flex items-center justify-center">
                                        <i class="sicon-truck text-blue-600"></i>
                                    </div>
                                    {% elseif order.status == 'processing' %}
                                    <div class="w-10 h-10 bg-yellow-100 rounded-full flex items-center justify-center">
                                        <i class="sicon-clock text-yellow-600"></i>
                                    </div>
                                    {% else %}
                                    <div class="w-10 h-10 bg-secondary-100 rounded-full flex items-center justify-center">
                                        <i class="sicon-package text-secondary-600"></i>
                                    </div>
                                    {% endif %}
                                </div>
                                
                                <!-- Order Details -->
                                <div>
                                    <div class="font-medium text-secondary-900">
                                        {{ 'Order #%s'|t|format(order.number) }}
                                    </div>
                                    <div class="text-sm text-secondary-600">
                                        {{ order.created_at|date('M j, Y') }} • {{ order.items_count }} {{ 'items'|t }}
                                    </div>
                                    <div class="text-xs text-secondary-500">
                                        {{ order.status|title }}
                                        {% if order.tracking_number %}
                                        • {{ 'Tracking: %s'|t|format(order.tracking_number) }}
                                        {% endif %}
                                    </div>
                                </div>
                            </div>
                            
                            <!-- Order Actions -->
                            <div class="flex items-center space-x-3">
                                <div class="text-right">
                                    <div class="font-semibold text-secondary-900">{{ order.total|money }}</div>
                                    {% if order.can_reorder %}
                                    <button class="text-xs text-primary-600 hover:text-primary-700 font-medium"
                                            data-reorder="{{ order.id }}">
                                        {{ 'Reorder'|t }}
                                    </button>
                                    {% endif %}
                                </div>
                                <a href="{{ store.url('customer.orders.show', order.id) }}" 
                                   class="btn btn-outline btn-sm">
                                    {{ 'View'|t }}
                                </a>
                            </div>
                        </div>
                    </div>
                    {% endfor %}
                </div>
                {% else %}
                <div class="empty-state p-8 text-center">
                    <div class="w-16 h-16 bg-secondary-100 rounded-full flex items-center justify-center mx-auto mb-4">
                        <i class="sicon-shopping-bag text-secondary-400 text-2xl"></i>
                    </div>
                    <h4 class="font-medium text-secondary-900 mb-2">{{ 'No orders yet'|t }}</h4>
                    <p class="text-sm text-secondary-600 mb-4">{{ 'Start shopping to see your orders here'|t }}</p>
                    <a href="{{ store.url('products.index') }}" class="btn btn-primary btn-sm">
                        {{ 'Start Shopping'|t }}
                    </a>
                </div>
                {% endif %}
            </div>
            
            <!-- Personalized Recommendations -->
            {% if user.recommendations|length > 0 %}
            <div class="recommendations bg-white border border-secondary-200 rounded-xl overflow-hidden">
                <div class="section-header p-4 border-b border-secondary-200">
                    <h3 class="text-lg font-semibold text-secondary-900">{{ 'Recommended for You'|t }}</h3>
                    <p class="text-sm text-secondary-600">{{ 'Based on your browsing and purchase history'|t }}</p>
                </div>
                
                <div class="recommendations-grid grid grid-cols-2 md:grid-cols-4 gap-4 p-4">
                    {% for product in user.recommendations|slice(0, 4) %}
                    <div class="recommendation-item">
                        <a href="{{ product.url }}" class="block group">
                            <div class="aspect-square rounded-lg overflow-hidden mb-2">
                                <img src="{{ product.image }}" 
                                     alt="{{ product.name }}"
                                     class="w-full h-full object-cover group-hover:scale-105 transition-transform">
                            </div>
                            <h4 class="font-medium text-sm text-secondary-900 line-clamp-2 mb-1">
                                {{ product.name }}
                            </h4>
                            <div class="text-primary-600 font-semibold">{{ product.price|money }}</div>
                        </a>
                        <button class="btn btn-primary btn-sm w-full mt-2 add-to-cart-btn"
                                data-product-id="{{ product.id }}">
                            {{ 'Add to Cart'|t }}
                        </button>
                    </div>
                    {% endfor %}
                </div>
            </div>
            {% endif %}
            
            <!-- Recently Viewed -->
            {% if user.recently_viewed|length > 0 %}
            <div class="recently-viewed bg-white border border-secondary-200 rounded-xl overflow-hidden">
                <div class="section-header flex items-center justify-between p-4 border-b border-secondary-200">
                    <h3 class="text-lg font-semibold text-secondary-900">{{ 'Recently Viewed'|t }}</h3>
                    <button class="text-primary-600 hover:text-primary-700 text-sm font-medium"
                            data-clear-history>
                        {{ 'Clear history'|t }}
                    </button>
                </div>
                
                <div class="recently-viewed-list p-4 space-y-3">
                    {% for item in user.recently_viewed|slice(0, 3) %}
                    <div class="viewed-item flex items-center space-x-4 p-3 hover:bg-secondary-50 rounded-lg transition-colors">
                        <img src="{{ item.product.image }}" 
                             alt="{{ item.product.name }}"
                             class="w-12 h-12 object-cover rounded-lg">
                        <div class="flex-1 min-w-0">
                            <h4 class="font-medium text-sm text-secondary-900 truncate">
                                {{ item.product.name }}
                            </h4>
                            <div class="text-xs text-secondary-500">
                                {{ 'Viewed %s'|t|format(item.viewed_at|time_ago) }}
                            </div>
                        </div>
                        <div class="text-primary-600 font-medium">
                            {{ item.product.price|money }}
                        </div>
                        <a href="{{ item.product.url }}" 
                           class="btn btn-outline btn-sm">
                            {{ 'View'|t }}
                        </a>
                    </div>
                    {% endfor %}
                </div>
            </div>
            {% endif %}
        </div>
        
        <!-- Sidebar -->
        <div class="sidebar space-y-6">
            
            <!-- Quick Links -->
            <div class="quick-links bg-white border border-secondary-200 rounded-xl p-4">
                <h3 class="font-semibold text-secondary-900 mb-4">{{ 'Quick Links'|t }}</h3>
                <div class="space-y-2">
                    <a href="{{ store.url('customer.profile') }}" 
                       class="flex items-center space-x-3 p-3 hover:bg-secondary-50 rounded-lg transition-colors">
                        <i class="sicon-user text-secondary-600"></i>
                        <span class="text-sm text-secondary-700">{{ 'Profile Settings'|t }}</span>
                    </a>
                    
                    <a href="{{ store.url('customer.addresses') }}" 
                       class="flex items-center space-x-3 p-3 hover:bg-secondary-50 rounded-lg transition-colors">
                        <i class="sicon-map-pin text-secondary-600"></i>
                        <span class="text-sm text-secondary-700">{{ 'Address Book'|t }}</span>
                    </a>
                    
                    <a href="{{ store.url('customer.wishlist') }}" 
                       class="flex items-center space-x-3 p-3 hover:bg-secondary-50 rounded-lg transition-colors">
                        <i class="sicon-heart text-secondary-600"></i>
                        <span class="text-sm text-secondary-700">{{ 'Wishlist'|t }}</span>
                        {% if user.wishlist_count > 0 %}
                        <span class="bg-primary-100 text-primary-600 text-xs px-2 py-1 rounded-full">
                            {{ user.wishlist_count }}
                        </span>
                        {% endif %}
                    </a>
                    
                    <a href="{{ store.url('customer.reviews') }}" 
                       class="flex items-center space-x-3 p-3 hover:bg-secondary-50 rounded-lg transition-colors">
                        <i class="sicon-star text-secondary-600"></i>
                        <span class="text-sm text-secondary-700">{{ 'My Reviews'|t }}</span>
                    </a>
                    
                    <a href="{{ store.url('customer.loyalty') }}" 
                       class="flex items-center space-x-3 p-3 hover:bg-secondary-50 rounded-lg transition-colors">
                        <i class="sicon-gift text-secondary-600"></i>
                        <span class="text-sm text-secondary-700">{{ 'Loyalty Program'|t }}</span>
                    </a>
                    
                    <a href="{{ store.url('customer.support') }}" 
                       class="flex items-center space-x-3 p-3 hover:bg-secondary-50 rounded-lg transition-colors">
                        <i class="sicon-headset text-secondary-600"></i>
                        <span class="text-sm text-secondary-700">{{ 'Support'|t }}</span>
                    </a>
                </div>
            </div>
            
            <!-- Loyalty Status -->
            {% if user.loyalty_program %}
            <div class="loyalty-status bg-gradient-to-br from-purple-50 to-pink-50 border border-purple-200 rounded-xl p-4">
                <div class="flex items-center space-x-3 mb-3">
                    <div class="w-10 h-10 bg-purple-100 rounded-full flex items-center justify-center">
                        <i class="sicon-crown text-purple-600"></i>
                    </div>
                    <div>
                        <h3 class="font-semibold text-purple-900">{{ user.loyalty_tier }}</h3>
                        <div class="text-xs text-purple-600">{{ 'Loyalty Member'|t }}</div>
                    </div>
                </div>
                
                <div class="mb-3">
                    <div class="flex justify-between text-sm mb-1">
                        <span class="text-purple-700">{{ 'Progress to next tier'|t }}</span>
                        <span class="text-purple-600">{{ user.loyalty_progress }}%</span>
                    </div>
                    <div class="w-full bg-purple-200 rounded-full h-2">
                        <div class="bg-purple-600 h-2 rounded-full transition-all duration-500" 
                             style="width: {{ user.loyalty_progress }}%"></div>
                    </div>
                </div>
                
                <div class="text-xs text-purple-600">
                    {{ 'Spend %s more to reach %s'|t|format(user.loyalty_next_tier_amount|money, user.loyalty_next_tier) }}
                </div>
            </div>
            {% endif %}
            
            <!-- Special Offers -->
            {% if user.special_offers|length > 0 %}
            <div class="special-offers bg-white border border-secondary-200 rounded-xl p-4">
                <h3 class="font-semibold text-secondary-900 mb-4">{{ 'Special Offers'|t }}</h3>
                <div class="space-y-3">
                    {% for offer in user.special_offers|slice(0, 2) %}
                    <div class="offer-item p-3 bg-gradient-to-r from-green-50 to-blue-50 border border-green-200 rounded-lg">
                        <div class="flex items-start space-x-3">
                            <div class="w-8 h-8 bg-green-100 rounded-full flex items-center justify-center">
                                <i class="sicon-gift text-green-600 text-sm"></i>
                            </div>
                            <div class="flex-1">
                                <h4 class="font-medium text-sm text-secondary-900">{{ offer.title }}</h4>
                                <p class="text-xs text-secondary-600 mb-2">{{ offer.description }}</p>
                                <div class="flex items-center justify-between">
                                    <span class="text-xs text-green-600 font-medium">
                                        {{ 'Expires %s'|t|format(offer.expires_at|date('M j')) }}
                                    </span>
                                    <button class="text-xs text-primary-600 hover:text-primary-700 font-medium"
                                            data-use-offer="{{ offer.code }}">
                                        {{ 'Use Code'|t }}
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                    {% endfor %}
                </div>
            </div>
            {% endif %}
            
            <!-- Account Security -->
            <div class="account-security bg-white border border-secondary-200 rounded-xl p-4">
                <h3 class="font-semibold text-secondary-900 mb-4">{{ 'Account Security'|t }}</h3>
                <div class="space-y-3">
                    <div class="security-item flex items-center justify-between">
                        <div class="flex items-center space-x-3">
                            <i class="sicon-shield-check text-green-600"></i>
                            <span class="text-sm text-secondary-700">{{ 'Email Verified'|t }}</span>
                        </div>
                        <i class="sicon-check text-green-600"></i>
                    </div>
                    
                    <div class="security-item flex items-center justify-between">
                        <div class="flex items-center space-x-3">
                            <i class="sicon-smartphone text-secondary-600"></i>
                            <span class="text-sm text-secondary-700">{{ 'Two-Factor Auth'|t }}</span>
                        </div>
                        {% if user.two_factor_enabled %}
                        <i class="sicon-check text-green-600"></i>
                        {% else %}
                        <button class="text-xs text-primary-600 hover:text-primary-700 font-medium"
                                data-enable-2fa>
                            {{ 'Enable'|t }}
                        </button>
                        {% endif %}
                    </div>
                    
                    <div class="security-item flex items-center justify-between">
                        <div class="flex items-center space-x-3">
                            <i class="sicon-lock text-secondary-600"></i>
                            <span class="text-sm text-secondary-700">{{ 'Password'|t }}</span>
                        </div>
                        <button class="text-xs text-primary-600 hover:text-primary-700 font-medium"
                                data-change-password>
                            {{ 'Change'|t }}
                        </button>
                    </div>
                </div>
                
                <div class="mt-4 p-3 bg-yellow-50 border border-yellow-200 rounded-lg">
                    <div class="flex items-start space-x-2">
                        <i class="sicon-alert-triangle text-yellow-600 text-sm mt-0.5"></i>
                        <div>
                            <div class="text-xs font-medium text-yellow-800">{{ 'Security Tip'|t }}</div>
                            <div class="text-xs text-yellow-700">
                                {{ 'Last login: %s from %s'|t|format(user.last_login|time_ago, user.last_login_location) }}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
// Advanced Account Dashboard Functionality
document.addEventListener('DOMContentLoaded', function() {
    const dashboard = document.querySelector('[data-component="account-dashboard"]');
    if (!dashboard) return;
    
    // Reorder functionality
    document.addEventListener('click', async function(e) {
        const reorderBtn = e.target.closest('[data-reorder]');
        if (!reorderBtn) return;
        
        const orderId = reorderBtn.dataset.reorder;
        await reorderItems(orderId);
    });
    
    // Add to cart from recommendations
    document.addEventListener('click', async function(e) {
        const addToCartBtn = e.target.closest('.add-to-cart-btn');
        if (!addToCartBtn) return;
        
        const productId = addToCartBtn.dataset.productId;
        await addToCart(productId);
    });
    
    // Clear browsing history
    document.addEventListener('click', async function(e) {
        const clearHistoryBtn = e.target.closest('[data-clear-history]');
        if (!clearHistoryBtn) return;
        
        if (confirm('{{ "Clear your browsing history?"|t }}')) {
            await clearBrowsingHistory();
        }
    });
    
    // Use offer code
    document.addEventListener('click', function(e) {
        const useOfferBtn = e.target.closest('[data-use-offer]');
        if (!useOfferBtn) return;
        
        const code = useOfferBtn.dataset.useOffer;
        copyToClipboard(code);
        showNotification(`{{ "Offer code copied: "|t }}${code}`, 'success');
    });
    
    // Enable 2FA
    document.addEventListener('click', function(e) {
        const enable2faBtn = e.target.closest('[data-enable-2fa]');
        if (!enable2faBtn) return;
        
        // Redirect to 2FA setup
        window.location.href = '{{ store.url("customer.security.2fa") }}';
    });
    
    // Change password
    document.addEventListener('click', function(e) {
        const changePasswordBtn = e.target.closest('[data-change-password]');
        if (!changePasswordBtn) return;
        
        // Redirect to change password
        window.location.href = '{{ store.url("customer.security.password") }}';
    });
    
    // Edit profile
    document.addEventListener('click', function(e) {
        const editProfileBtn = e.target.closest('[data-edit-profile]');
        if (!editProfileBtn) return;
        
        // Redirect to profile edit
        window.location.href = '{{ store.url("customer.profile.edit") }}';
    });
    
    // Notifications toggle
    document.addEventListener('click', function(e) {
        const notificationsToggle = e.target.closest('[data-notifications-toggle]');
        if (!notificationsToggle) return;
        
        // Toggle notifications dropdown (implement as needed)
        console.log('Toggle notifications');
    });
    
    async function reorderItems(orderId) {
        try {
            const response = await fetch(`{{ store.url('customer.orders.reorder') }}`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-Requested-With': 'XMLHttpRequest'
                },
                body: JSON.stringify({ order_id: orderId })
            });
            
            const data = await response.json();
            
            if (data.success) {
                showNotification('{{ "Items added to cart"|t }}', 'success');
                updateHeaderCartCount(data.cart_count);
            } else {
                showNotification(data.message || '{{ "Failed to reorder items"|t }}', 'error');
            }
        } catch (error) {
            console.error('Reorder error:', error);
            showNotification('{{ "An error occurred"|t }}', 'error');
        }
    }
    
    async function addToCart(productId) {
        try {
            const response = await fetch(`{{ store.url('cart.add') }}`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-Requested-With': 'XMLHttpRequest'
                },
                body: JSON.stringify({
                    product_id: productId,
                    quantity: 1
                })
            });
            
            const data = await response.json();
            
            if (data.success) {
                showNotification('{{ "Product added to cart"|t }}', 'success');
                updateHeaderCartCount(data.cart_count);
            } else {
                showNotification(data.message || '{{ "Failed to add to cart"|t }}', 'error');
            }
        } catch (error) {
            console.error('Add to cart error:', error);
            showNotification('{{ "An error occurred"|t }}', 'error');
        }
    }
    
    async function clearBrowsingHistory() {
        try {
            const response = await fetch(`{{ store.url('customer.history.clear') }}`, {
                method: 'POST',
                headers: {
                    'X-Requested-With': 'XMLHttpRequest'
                }
            });
            
            const data = await response.json();
            
            if (data.success) {
                // Remove recently viewed section
                const recentlyViewed = document.querySelector('.recently-viewed');
                if (recentlyViewed) {
                    recentlyViewed.remove();
                }
                showNotification('{{ "Browsing history cleared"|t }}', 'success');
            } else {
                showNotification(data.message || '{{ "Failed to clear history"|t }}', 'error');
            }
        } catch (error) {
            console.error('Clear history error:', error);
            showNotification('{{ "An error occurred"|t }}', 'error');
        }
    }
    
    function copyToClipboard(text) {
        if (navigator.clipboard) {
            navigator.clipboard.writeText(text);
        } else {
            // Fallback for older browsers
            const textArea = document.createElement('textarea');
            textArea.value = text;
            document.body.appendChild(textArea);
            textArea.focus();
            textArea.select();
            document.execCommand('copy');
            document.body.removeChild(textArea);
        }
    }
    
    function updateHeaderCartCount(count) {
        const headerCartCount = document.querySelector('.header-actions .badge');
        if (headerCartCount) {
            headerCartCount.textContent = count;
            headerCartCount.style.display = count > 0 ? 'flex' : 'none';
        }
    }
    
    function showNotification(message, type = 'info') {
        if (window.Swal) {
            Swal.fire({
                toast: true,
                position: '{{ store.direction == "rtl" ? "top-left" : "top-right" }}',
                icon: type,
                title: message,
                showConfirmButton: false,
                timer: 3000,
                timerProgressBar: true
            });
        } else {
            alert(message);
        }
    }
    
    // Auto-refresh stats periodically
    setInterval(async function() {
        try {
            const response = await fetch(`{{ store.url('api.customer.stats') }}`, {
                headers: {
                    'X-Requested-With': 'XMLHttpRequest'
                }
            });
            
            if (response.ok) {
                const data = await response.json();
                updateDashboardStats(data);
            }
        } catch (error) {
            // Silently fail - this is just for live updates
            console.log('Stats refresh failed:', error);
        }
    }, 60000); // Refresh every minute
    
    function updateDashboardStats(stats) {
        // Update stat cards with latest data
        const statCards = document.querySelectorAll('.stat-card');
        
        // Update orders count
        if (stats.orders_count !== undefined) {
            const ordersCard = statCards[0];
            if (ordersCard) {
                ordersCard.querySelector('.text-2xl').textContent = stats.orders_count;
            }
        }
        
        // Update total spent
        if (stats.total_spent !== undefined) {
            const spentCard = statCards[1];
            if (spentCard) {
                spentCard.querySelector('.text-2xl').textContent = stats.total_spent;
            }
        }
        
        // Update loyalty points
        if (stats.loyalty_points !== undefined) {
            const pointsCard = statCards[2];
            if (pointsCard) {
                pointsCard.querySelector('.text-2xl').textContent = stats.loyalty_points;
            }
        }
        
        // Update wishlist count
        if (stats.wishlist_count !== undefined) {
            const wishlistCard = statCards[3];
            if (wishlistCard) {
                wishlistCard.querySelector('.text-2xl').textContent = stats.wishlist_count;
            }
        }
    }
});
</script>