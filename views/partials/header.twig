<header class="header header--{{ theme.header_style|default('modern') }}">
    <!-- Top Bar -->
    <div class="header__top-bar">
        <div class="container">
            <div class="top-bar">
                <div class="top-bar__left">
                    <!-- Language & Currency -->
                    <div class="header__utilities">
                        {% if store.languages|length > 1 %}
                        <div class="language-selector">
                            <button class="language-selector__toggle">
                                <span>{{ store.current_language.name }}</span>
                                <i class="icon-chevron-down"></i>
                            </button>
                            <ul class="language-selector__list">
                                {% for language in store.languages %}
                                <li>
                                    <a href="{{ language.url }}" class="{% if language.code == store.current_language.code %}active{% endif %}">
                                        {{ language.name }}
                                    </a>
                                </li>
                                {% endfor %}
                            </ul>
                        </div>
                        {% endif %}
                        
                        {% if store.currencies|length > 1 %}
                        <div class="currency-selector">
                            <button class="currency-selector__toggle">
                                <span>{{ store.current_currency.code }}</span>
                                <i class="icon-chevron-down"></i>
                            </button>
                            <ul class="currency-selector__list">
                                {% for currency in store.currencies %}
                                <li>
                                    <a href="{{ currency.url }}" class="{% if currency.code == store.current_currency.code %}active{% endif %}">
                                        {{ currency.name }} ({{ currency.symbol }})
                                    </a>
                                </li>
                                {% endfor %}
                            </ul>
                        </div>
                        {% endif %}
                    </div>
                </div>
                
                <div class="top-bar__right">
                    <!-- Contact Info -->
                    <div class="contact-info">
                        {% if store.phone %}
                        <a href="tel:{{ store.phone }}" class="contact-info__item">
                            <i class="icon-phone"></i>
                            <span>{{ store.phone }}</span>
                        </a>
                        {% endif %}
                        
                        {% if store.email %}
                        <a href="mailto:{{ store.email }}" class="contact-info__item">
                            <i class="icon-email"></i>
                            <span>{{ store.email }}</span>
                        </a>
                        {% endif %}
                    </div>
                    
                    <!-- Social Links -->
                    {% if store.social_links %}
                    <div class="social-links">
                        {% for social in store.social_links %}
                        <a href="{{ social.url }}" target="_blank" rel="noopener" class="social-links__item">
                            <i class="icon-{{ social.platform }}"></i>
                        </a>
                        {% endfor %}
                    </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
    
    <!-- Main Header -->
    <div class="header__main">
        <div class="container">
            <div class="header__content">
                <!-- Mobile Menu Toggle -->
                <button class="mobile-menu-toggle" id="mobileMenuToggle">
                    <span></span>
                    <span></span>
                    <span></span>
                </button>
                
                <!-- Logo -->
                <div class="header__logo">
                    <a href="{{ store.url }}" class="logo">
                        {% if theme.logo %}
                        <img src="{{ theme.logo }}" alt="{{ store.name }}" class="logo__image">
                        {% else %}
                        <span class="logo__text">{{ store.name }}</span>
                        {% endif %}
                    </a>
                </div>
                
                <!-- Search Bar -->
                <div class="header__search">
                    <form class="search-form" action="{{ url('search') }}" method="get">
                        <div class="search-input-group">
                            <input type="text" name="q" placeholder="{{ 'Search for products...'|t }}" class="search-input" value="{{ request.q }}">
                            <button type="submit" class="search-button">
                                <i class="icon-search"></i>
                            </button>
                        </div>
                    </form>
                </div>
                
                <!-- Header Actions -->
                <div class="header__actions">
                    <!-- User Account -->
                    <div class="header-action">
                        <a href="{{ user.is_guest ? url('login') : url('account') }}" class="header-action__link">
                            <i class="icon-user"></i>
                            <span class="header-action__text">
                                {{ user.is_guest ? 'Login'|t : user.name }}
                            </span>
                        </a>
                    </div>
                    
                    <!-- Wishlist -->
                    <div class="header-action">
                        <a href="{{ url('wishlist') }}" class="header-action__link">
                            <i class="icon-heart"></i>
                            <span class="header-action__count">{{ wishlist.items_count }}</span>
                            <span class="header-action__text">{{ 'Wishlist'|t }}</span>
                        </a>
                    </div>
                    
                    <!-- Compare -->
                    <div class="header-action">
                        <a href="{{ url('compare') }}" class="header-action__link">
                            <i class="icon-compare"></i>
                            <span class="header-action__count">{{ compare.items_count }}</span>
                            <span class="header-action__text">{{ 'Compare'|t }}</span>
                        </a>
                    </div>
                    
                    <!-- Cart -->
                    <div class="header-action header-action--cart">
                        <button class="header-action__link" id="cartToggle">
                            <i class="icon-cart"></i>
                            <span class="header-action__count">{{ cart.items_count }}</span>
                            <span class="header-action__text">{{ 'Cart'|t }}</span>
                            <span class="header-action__total">{{ cart.total }}</span>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Navigation -->
    <nav class="header__nav">
        <div class="container">
            <ul class="main-nav">
                {% for category in store.main_categories %}
                <li class="main-nav__item {% if category.children %}has-children{% endif %}">
                    <a href="{{ category.url }}" class="main-nav__link">
                        {{ category.name }}
                        {% if category.children %}
                        <i class="icon-chevron-down"></i>
                        {% endif %}
                    </a>
                    
                    {% if category.children %}
                    <div class="mega-menu">
                        <div class="mega-menu__content">
                            {% for child_category in category.children %}
                            <div class="mega-menu__column">
                                <h4 class="mega-menu__title">
                                    <a href="{{ child_category.url }}">{{ child_category.name }}</a>
                                </h4>
                                {% if child_category.children %}
                                <ul class="mega-menu__list">
                                    {% for sub_category in child_category.children %}
                                    <li>
                                        <a href="{{ sub_category.url }}">{{ sub_category.name }}</a>
                                    </li>
                                    {% endfor %}
                                </ul>
                                {% endif %}
                            </div>
                            {% endfor %}
                        </div>
                    </div>
                    {% endif %}
                </li>
                {% endfor %}
            </ul>
        </div>
    </nav>
    
    <!-- Mobile Menu -->
    <div class="mobile-menu" id="mobileMenu">
        <div class="mobile-menu__header">
            <div class="mobile-menu__logo">
                {% if theme.logo %}
                <img src="{{ theme.logo }}" alt="{{ store.name }}">
                {% else %}
                <span>{{ store.name }}</span>
                {% endif %}
            </div>
            <button class="mobile-menu__close" id="mobileMenuClose">
                <i class="icon-close"></i>
            </button>
        </div>
        
        <div class="mobile-menu__content">
            <!-- Mobile Search -->
            <div class="mobile-menu__search">
                <form action="{{ url('search') }}" method="get">
                    <div class="search-input-group">
                        <input type="text" name="q" placeholder="{{ 'Search...'|t }}">
                        <button type="submit">
                            <i class="icon-search"></i>
                        </button>
                    </div>
                </form>
            </div>
            
            <!-- Mobile Navigation -->
            <ul class="mobile-nav">
                {% for category in store.main_categories %}
                <li class="mobile-nav__item {% if category.children %}has-children{% endif %}">
                    <a href="{{ category.url }}" class="mobile-nav__link">
                        {{ category.name }}
                        {% if category.children %}
                        <i class="icon-chevron-right"></i>
                        {% endif %}
                    </a>
                    
                    {% if category.children %}
                    <ul class="mobile-nav__submenu">
                        {% for child_category in category.children %}
                        <li>
                            <a href="{{ child_category.url }}">{{ child_category.name }}</a>
                        </li>
                        {% endfor %}
                    </ul>
                    {% endif %}
                </li>
                {% endfor %}
            </ul>
            
            <!-- Mobile Account Links -->
            <div class="mobile-menu__account">
                {% if user.is_guest %}
                <a href="{{ url('login') }}" class="mobile-menu__account-link">
                    <i class="icon-login"></i>
                    {{ 'Login'|t }}
                </a>
                <a href="{{ url('register') }}" class="mobile-menu__account-link">
                    <i class="icon-user-plus"></i>
                    {{ 'Register'|t }}
                </a>
                {% else %}
                <a href="{{ url('account') }}" class="mobile-menu__account-link">
                    <i class="icon-user"></i>
                    {{ 'My Account'|t }}
                </a>
                <a href="{{ url('logout') }}" class="mobile-menu__account-link">
                    <i class="icon-logout"></i>
                    {{ 'Logout'|t }}
                </a>
                {% endif %}
            </div>
        </div>
    </div>
</header>